# ============================================================================
# VERITENSOR — example environment. Copy to .env and edit.
# NEVER commit a real .env. No secret in this file is a working credential.
# ============================================================================

# --- runtime ---------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production | test
SIMULATION_MODE=true             # true = SimulationAdapter, false = BittensorAdapter

# --- persistence -----------------------------------------------------------
# SQLite is the zero-config default. Point at PostgreSQL for a real deployment.
DATABASE_URL=sqlite:///./veritensor.db
# DATABASE_URL=postgresql+psycopg://veritensor:veritensor@postgres:5432/veritensor

# --- subnet ----------------------------------------------------------------
SUBNET_NETUID=47
BITTENSOR_NETWORK=test           # test | finney | ws://127.0.0.1:9944
BITTENSOR_WALLET_NAME=
BITTENSOR_HOTKEY_NAME=
BITTENSOR_WALLET_PATH=~/.bittensor/wallets
BITTENSOR_WEIGHTS_VERSION_KEY=0
# BITTENSOR_MECHID=0             # only for Bittensor SDK v10 multi-mechanism subnets

# --- demo seeding ----------------------------------------------------------
AUTOSEED=true
SEED_MINERS=16
SEED_VALIDATORS=4
SEED_TASKS=260
RANDOM_SEED=1337

# --- security --------------------------------------------------------------
# Required for /api/admin/* and ground-truth reveal outside development.
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=240
SIMULATION_RATE_LIMIT_PER_MINUTE=12
MAX_SIMULATION_TASKS=400
MAX_SIMULATION_MINERS=60
ENABLE_DEBUG_ENDPOINTS=true      # forced off when ENVIRONMENT=production
# Used for the HMAC commitment over hidden ground truth. Change it.
VERITENSOR_COMMIT_SECRET=change-me-in-any-real-deployment

# --- neuron processes (subnet/neurons) -------------------------------------
# Mode is enforced by config validation: bittensor_testnet refuses unsigned
# transport, generated wallets and netuid 0.
VERITENSOR_MODE=local_neurons        # simulation | local_neurons | bittensor_testnet
VERITENSOR_AXON_HOST=0.0.0.0
VERITENSOR_AXON_PORT=9100
VERITENSOR_AXON_EXTERNAL_IP=127.0.0.1
VERITENSOR_EVIDENCE_DIR=evidence
VERITENSOR_LOG_LEVEL=INFO

# --- optional model backend for real (non-simulated) miners ----------------
# Leave empty to use the offline EchoBackend. The key is read by the miner
# process only and is never sent to the frontend.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
MODEL_TEMPERATURE=0.2

# --- optional mechanism override -------------------------------------------
# VERITENSOR_SCORE_WEIGHTS={"accuracy":0.45,"evidence":0.20,"robustness":0.15,"calibration":0.10,"latency":0.10}

# --- frontend --------------------------------------------------------------
# Server-side only; the browser never sees this value.
BACKEND_URL=http://127.0.0.1:8000
