# ---- VERITENSOR backend + subnet core --------------------------------------
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-bittensor.txt ./
RUN pip install --no-cache-dir -r requirements.txt
# The Bittensor SDK is needed for signed transport and chain access. Installed
# in the same image so the miner/validator neuron profiles can run from it.
ARG INSTALL_BITTENSOR=1
RUN if [ "$INSTALL_BITTENSOR" = "1" ]; then \
      pip install --no-cache-dir -r requirements-bittensor.txt; \
    fi

COPY subnet ./subnet
COPY backend ./backend
COPY benchmarks ./benchmarks
COPY configs ./configs
COPY scripts ./scripts

# non-root runtime user
RUN useradd --uid 10001 --create-home veritensor && chown -R veritensor /app
USER veritensor

EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=4s --start-period=40s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
